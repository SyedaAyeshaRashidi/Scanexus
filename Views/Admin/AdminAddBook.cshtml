@model LibrarySystem.Models.Book
@{
    ViewData["Title"] = "Add Book";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h4>Add New Book</h4>
    <p>Fill in the details to add a book to the library</p>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="form-card">
            <form asp-action="AddBook" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Book Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Database System Concepts" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Author *</label>
                    <input asp-for="Author" class="form-control" placeholder="e.g. Silberschatz, Korth" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Publisher</label>
                    <input asp-for="Publisher" class="form-control" placeholder="e.g. McGraw-Hill" />
                </div>
                <div class="mb-3">
                    <label class="form-label">ISBN</label>
                    <input asp-for="ISBN" class="form-control" id="isbnInput" readonly
                           placeholder="Auto-generated on save" />
                    <div class="form-text text-secondary small">
                        ISBN aur QR code automatically generate honge
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Number of Copies *</label>
                    <input asp-for="TotalCopies" type="number" min="1" class="form-control" value="1" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-green px-4">
                        <i class="bi bi-plus-lg me-2"></i>Add Book
                    </button>
                    <a href="/Admin/Books" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    fetch('/Admin/LastBookISBN')
        .then(r => r.json())
        .then(data => {
            document.getElementById('isbnInput').value = data.isbn;
        });
</script>