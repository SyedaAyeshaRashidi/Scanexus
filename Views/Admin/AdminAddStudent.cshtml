@model LibrarySystem.Models.Student
@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h4>Add New Student</h4>
    <p>Fill in the details to register a student</p>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="form-card">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">@TempData["Error"]</div>
            }
            <form asp-action="AddStudent" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Full Name *</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Sara Ahmed" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Father Name *</label>
                    <input asp-for="FatherName" class="form-control" placeholder="e.g. Ahmed Ali" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email *</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="e.g. sara@ssuet.edu.pk" />
                </div>
                <div class="mb-3">
                    <label class="form-label">University ID *</label>
                    <input asp-for="UniversityID" class="form-control" placeholder="e.g. 2024F-BS-0001" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password *</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Enter password" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Semester</label>
                    <input asp-for="Semester" type="number" min="1" max="8" class="form-control" placeholder="e.g. 4" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Batch</label>
                    <input asp-for="Batch" class="form-control" placeholder="e.g. 2024F" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-green px-4">
                        <i class="bi bi-person-plus me-2"></i>Add Student
                    </button>
                    <a href="/Admin/Students" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>