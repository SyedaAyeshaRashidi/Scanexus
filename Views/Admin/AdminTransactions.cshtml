@model List<LibrarySystem.Models.Transaction>
@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h4>All Transactions</h4>
    <p>Complete borrowing history — @Model.Count records</p>
</div>

<div class="data-table">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Transaction ID</th>
                    <th>Student</th>
                    <th>Book</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td><code>@t.TxnCode</code></td>
                        <td>
                            <div class="text-white" style="font-size:0.88rem;">@t.Student?.FullName</div>
                            <div style="color:#555; font-size:0.75rem;">@t.Student?.UniversityID</div>
                        </td>
                        <td class="text-white" style="font-size:0.88rem;">@t.Book?.Title</td>
                        <td style="color:#888; font-size:0.85rem;">@t.IssueDate.ToString("dd MMM yyyy")</td>
                        <td style="font-size:0.85rem;">
                            <span class="@(t.DueDate < DateTime.Now && t.Status == "Active" ? "text-danger" : "text-secondary")">
                                @t.DueDate.ToString("dd MMM yyyy")
                            </span>
                        </td>
                        <td style="color:#888; font-size:0.85rem;">
                            @(t.ReturnDate.HasValue ? t.ReturnDate.Value.ToString("dd MMM yyyy") : "—")
                        </td>
                        <td>
                            @if (t.Status == "Active")
                            {
                                <span class="badge" style="background:rgba(74,222,128,0.15); color:#4ade80;">Active</span>
                            }
                            else if (t.Status == "Returned")
                            {
                                <span class="badge" style="background:rgba(100,100,100,0.2); color:#888;">Returned</span>
                            }
                            else
                            {
                                <span class="badge" style="background:rgba(239,68,68,0.15); color:#ef4444;">Overdue</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
