@model List<LibrarySystem.Models.Book>
@{
    ViewData["Title"] = "Books Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* 🌌 CORE LAYOUT & ACCENT BRANDING */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

            .page-header h4 {
                color: #ffffff;
                font-weight: 800;
                margin: 0;
                font-size: 1.5rem;
                letter-spacing: -0.5px;
            }

            .page-header p {
                color: #94a3b8;
                font-size: 0.9rem;
                margin: 4px 0 0;
                font-weight: 500;
            }

        /* 🟦 NEON BLUE BRAND BUTTON */
        .btn-add-book {
            background: linear-gradient(135deg, #1e40af, #2563eb);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.25);
            border: 1px solid rgba(59, 130, 246, 0.4);
            color: #ffffff;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 0.7rem 1.5rem;
            border-radius: 10px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            transition: all 0.25s ease;
        }

            .btn-add-book:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(37, 99, 235, 0.4);
                background: #2563eb;
                color: #ffffff;
            }

        .analytics-summary-row {
            margin-bottom: 2.5rem;
        }

        /* 🔲 BLACK-SILVER MINIMAL CARDS */
        .analytics-card {
            background: #090d16;
            border: 1px solid rgba(59, 130, 246, 0.15);
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
            position: relative;
        }

            .analytics-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 100%;
                background: #2563eb; /* Blue Accent Sidebar Edge */
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
            }

            .analytics-card h6 {
                color: #94a3b8;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 8px;
            }

            .analytics-card h3 {
                color: #ffffff;
                font-weight: 800;
                font-size: 1.8rem;
                margin: 0;
                font-family: ui-monospace, SFMono-Regular, SF Pro Mono, Consolas, monospace;
            }

        /* 💻 PURE ENTERPRISE DARK TABLE WORKSPACE */
        .data-table-container {
            background: #090d16 !important;
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .table {
            margin: 0;
            color: #cbd5e1 !important;
            background-color: #090d16 !important;
        }

            .table thead th {
                background: #05070f !important;
                color: #ffffff !important;
                font-size: 0.75rem;
                text-transform: uppercase;
                font-weight: 700;
                letter-spacing: 1px;
                padding: 1.2rem 1.5rem;
                border-bottom: 1px solid rgba(59, 130, 246, 0.2) !important;
            }

            .table tbody tr {
                background-color: #090d16 !important;
                transition: background-color 0.2s ease;
            }

            .table tbody td {
                border-bottom: 1px solid rgba(255, 255, 255, 0.02) !important;
                padding: 1.2rem 1.5rem;
                vertical-align: middle;
                color: #cbd5e1 !important;
                background-color: transparent !important;
            }

            .table tbody tr:hover td {
                background: rgba(37, 99, 235, 0.03) !important; /* Subtle blue tint on hover */
                color: #ffffff !important;
            }

        .book-title-cell {
            color: #ffffff !important;
            font-weight: 600;
            font-size: 0.98rem;
        }

        /* 🔵 NEON BLUE TOKEN LABELS */
        .code-spec {
            color: #3b82f6;
            background: rgba(37, 99, 235, 0.07);
            border: 1px solid rgba(37, 99, 235, 0.15);
            padding: 5px 12px;
            border-radius: 6px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .stock-indicator {
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .btn-remove-destructive {
            background: rgba(239, 68, 68, 0.02);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #fca5a5;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .btn-remove-destructive:hover {
                background: #ef4444;
                border-color: #ef4444;
                color: #ffffff;
            }
    </style>
}

<div class="page-header">
    <div>
        <h4><i class="bi bi-collection-fill me-2" style="color:#3b82f6;"></i>Books Management</h4>
        <p>@Model.Count titles indexed across global catalog cluster</p>
    </div>
    <a href="/Admin/AddBook" class="btn-add-book">
        <i class="bi bi-plus-lg"></i> Add New Book
    </a>
</div>

<div class="row analytics-summary-row g-4">
    <div class="col-md-4">
        <div class="analytics-card">
            <h6>Total Stock Registry</h6>
            <h3>@Model.Sum(b => b.TotalCopies)</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="analytics-card" style="border-color: rgba(245, 158, 11, 0.2);">
            <h6>Currently Circulating</h6>
            <h3 style="color: #f59e0b !important;">@Model.Sum(b => b.TotalCopies - b.AvailableCopies)</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="analytics-card" style="border-color: rgba(16, 185, 129, 0.2);">
            <h6>Net Available Base</h6>
            <h3 style="color: #10b981 !important;">@Model.Sum(b => b.AvailableCopies)</h3>
        </div>
    </div>
</div>

<div class="data-table-container">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Author</th>
                    <th>ISBN Registry</th>
                    <th>QR Code</th>
                    <th>Stock Allocation</th>
                    <th>Operational Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td><span class="book-title-cell">@b.Title</span></td>
                        <td><span style="color: #cbd5e1; font-weight: 500;">@b.Author</span></td>
                        <td><span class="code-spec">@b.ISBN</span></td>
                        <td><span class="code-spec">@b.QRCode</span></td>
                        <td>
                            <div class="stock-indicator">
                                <span style="color: #3b82f6;">@b.AvailableCopies</span>
                                <span style="color: #475569; font-weight: 500;"> / @b.TotalCopies</span>
                            </div>
                        </td>
                        <td>
                            <form asp-action="DeleteBook" method="post" style="display:inline; margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@b.BookID" />
                                <button class="btn-remove-destructive" type="submit" onclick="return confirm('Wipe @b.Title records?')">
                                    <i class="bi bi-trash-fill me-1"></i> Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>